+/*
+ * The LPI core/audio clocks are provided by the ADSP (through q6prm over
+ * GLINK). While the ADSP has not booted yet, enabling them times out instead
+ * of returning a deferral. Report that as -EPROBE_DEFER so the consumer that
+ * triggered the pin access (codec, sound card) is retried once the ADSP is up
+ * instead of failing permanently.
+ */
+static int lpi_pinctrl_resume(struct lpi_pinctrl *pctrl)
+{
+	int ret = pm_runtime_resume_and_get(pctrl->dev);
+
+	if (ret == -ETIMEDOUT)
+		return -EPROBE_DEFER;
+
+	return ret;
+}
+
 static int lpi_gpio_read(struct lpi_pinctrl *state, unsigned int pin,
 			 unsigned int addr, u32 *val)
 {
 	int ret;
 
-	ret = pm_runtime_resume_and_get(state->dev);
+	ret = lpi_pinctrl_resume(state);
 	if (ret < 0)
 		return ret;
 
