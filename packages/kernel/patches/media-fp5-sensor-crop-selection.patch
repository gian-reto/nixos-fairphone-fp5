media: i2c: s5kjn1, imx858: report sensor-space selection rectangles

Libcamera probes sensor subdevices for crop and native-size selection
targets to derive pixel-array geometry. The IMX858 driver implements no
selection targets, while S5KJN1 only implements CROP and CROP_BOUNDS,
reports per-mode output dimensions, and copies width into height.

IMX858 reads an 8192x6144 area and applies 4x4 binning for its
2048x1536 output mode. Report the unbinned area for every selection
target.

Both S5KJN1 modes read an 8192x6176 source extent and use the same
8160x6144 active region at offset 16x16 before optional 2x2 binning.
Report the source extent as native size and the active region for all
crop targets.

Patch adapted from Marcus Ramberg's camera work in
marcusramberg/nixos-fairphone-fp5.

diff --git a/drivers/media/i2c/imx858.c b/drivers/media/i2c/imx858.c
index 5cf37c2..3124c04 100644
--- a/drivers/media/i2c/imx858.c
+++ b/drivers/media/i2c/imx858.c
@@ -55,6 +55,9 @@
 #define IMX858_LINK_FREQ	600000000
 #define IMX858_NUM_DATA_LANES	4
 
+#define IMX858_NATIVE_WIDTH	8192
+#define IMX858_NATIVE_HEIGHT	6144
+
 #define IMX858_REG_MIN		0x00
 #define IMX858_REG_MAX		0xffff
 
@@ -1009,6 +1012,28 @@ static int imx858_parse_hw_config(struct imx858 *imx858)
 	return ret;
 }
 
+static int imx858_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *sd_state,
+				struct v4l2_subdev_selection *sel)
+{
+	if (sel->which != V4L2_SUBDEV_FORMAT_ACTIVE)
+		return -EINVAL;
+
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = IMX858_NATIVE_WIDTH;
+		sel->r.height = IMX858_NATIVE_HEIGHT;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
 /* V4l2 subdevice ops */
 static const struct v4l2_subdev_video_ops imx858_video_ops = {
 	.s_stream = imx858_set_stream,
@@ -1019,6 +1044,7 @@ static const struct v4l2_subdev_pad_ops imx858_pad_ops = {
 	.enum_frame_size = imx858_enum_frame_size,
 	.get_fmt = imx858_get_pad_format,
 	.set_fmt = imx858_set_pad_format,
+	.get_selection = imx858_get_selection,
 };
 
 static const struct v4l2_subdev_ops imx858_subdev_ops = {
